apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: rke2-cilium
  namespace: kube-system
spec:
  valuesContent: |-
    # Bootstrap without depending on kube-proxy's service rules being ready.
    k8sServiceHost: "@KUBERNETES_API_HOST@"
    k8sServicePort: "6443"
    ipv4:
      enabled: false
    ipv6:
      enabled: true
    ipam:
      mode: kubernetes
    routingMode: native
    MTU: @MTU@
    ipv6NativeRoutingCIDR: "@POD_CIDR@"
    autoDirectNodeRoutes: true
    kubeProxyReplacement: false
    operator:
      replicas: 1
    hubble:
      enabled: false
