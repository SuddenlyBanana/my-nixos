server {
    listen @PUBLIC_V4@:25;
    listen [@PUBLIC_V6@]:25;
    proxy_bind @PROXY_ADDRESS@;
    proxy_pass [@RKE2_ADDRESS@]:30025;
    proxy_protocol on;
    proxy_connect_timeout 10s;
    proxy_timeout 1h;
}
server {
    listen @PUBLIC_V4@:465;
    listen [@PUBLIC_V6@]:465;
    proxy_bind @PROXY_ADDRESS@;
    proxy_pass [@RKE2_ADDRESS@]:30465;
    proxy_protocol on;
    proxy_connect_timeout 10s;
    proxy_timeout 1h;
}
server {
    listen @PUBLIC_V4@:993;
    listen [@PUBLIC_V6@]:993;
    proxy_bind @PROXY_ADDRESS@;
    proxy_pass [@RKE2_ADDRESS@]:30993;
    proxy_protocol on;
    proxy_connect_timeout 10s;
    proxy_timeout 1h;
}
