_: prev:

let
  # buildPackages' LLVM scope still supplies a cross compiler here.
  hostClang = prev.pkgsBuildBuild.llvmPackages_21.clang;
  hostRustTarget = prev.lib.replaceStrings [ "-" ] [ "_" ] prev.stdenv.buildPlatform.rust.rustcTarget;
  hostPcre2 = prev.pkgsBuildBuild.pcre2;
  hostNlua0 = prev.pkgsBuildBuild.neovim-unwrapped.overrideAttrs (_: {
    pname = "neovim-nlua0";
    buildFlags = [ "nlua0" ];
    preConfigure = "";
    doCheck = false;
    doInstallCheck = false;
    separateDebugInfo = false;
    installPhase = ''
      runHook preInstall
      mkdir -p "$out/lib"
      cp lib/libnlua0.so "$out/lib/"
      runHook postInstall
    '';
  });
in
{
  crun =
    if prev.stdenv.buildPlatform == prev.stdenv.hostPlatform then
      prev.crun
    else
      # UniFi uses regular OCI containers; the optional VM runtime builds its
      # own guest kernel and does not support this cross build.
      prev.crun.override {
        withLibkrun = false;
        withLibkrunSEV = false;
      };

  fish =
    if prev.stdenv.buildPlatform == prev.stdenv.hostPlatform then
      prev.fish
    else
      prev.fish.overrideAttrs (old: {
        # Cargo builds the documentation xtask for x86 alongside the ARM shell.
        # Use an unwrapped native pkg-config so Nix's cross wrapper cannot
        # redirect the helper's PCRE2 lookup to ARM libraries.
        env = (old.env or { }) // {
          "PKG_CONFIG_${hostRustTarget}" = "${prev.pkgsBuildBuild.pkg-config-unwrapped}/bin/pkg-config";
          "PKG_CONFIG_PATH_${hostRustTarget}" = "${prev.lib.getDev hostPcre2}/lib/pkgconfig";
          "PKG_CONFIG_LIBDIR_${hostRustTarget}" = "${prev.lib.getDev hostPcre2}/lib/pkgconfig";
          # A "/" sysroot produces //nix/store paths, which cc-wrapper drops.
          "PKG_CONFIG_SYSROOT_DIR_${hostRustTarget}" = "";
        };
        cmakeFlags = (old.cmakeFlags or [ ]) ++ [
          "-DFISH_INDENT_FOR_BUILDING_DOCS=${prev.pkgsBuildBuild.fish}/bin/fish_indent"
        ];
        disallowedRequisites = (old.disallowedRequisites or [ ]) ++ [
          hostPcre2
          prev.pkgsBuildBuild.fish
        ];
      });

  neovim-unwrapped =
    if prev.stdenv.buildPlatform == prev.stdenv.hostPlatform then
      prev.neovim-unwrapped
    else
      prev.neovim-unwrapped.overrideAttrs (old: {
        # Code generation runs native LuaJIT and must load a native nlua0.
        cmakeFlags = (old.cmakeFlags or [ ]) ++ [
          "-DNLUA0_HOST_PRG=${hostNlua0}/lib/libnlua0.so"
          # Help tags must also be generated by an executable for the build host.
          "-DNVIM_HOST_PRG=${prev.pkgsBuildBuild.neovim-unwrapped}/bin/nvim"
        ];
        disallowedRequisites = (old.disallowedRequisites or [ ]) ++ [
          hostNlua0
          prev.pkgsBuildBuild.neovim-unwrapped
        ];
      });

  wrapNeovimUnstable =
    if prev.stdenv.buildPlatform == prev.stdenv.hostPlatform then
      prev.wrapNeovimUnstable
    else
      neovim:
      prev.lib.makeOverridable (
        args:
        (prev.wrapNeovimUnstable neovim args).overrideAttrs (
          old:
          let
            manifestWrapperArgs =
              editor:
              prev.lib.escapeShellArgs [
                "${editor}/bin/nvim"
                "${placeholder "out"}/bin/nvim-wrapper"
              ];
            targetManifestArgs = builtins.unsafeDiscardStringContext (manifestWrapperArgs neovim);
          in
          {
            # The temporary manifest generator uses native Bash and Neovim.
            # The final wrapper still launches the AArch64 executable.
            postBuild =
              assert prev.lib.assertMsg (
                prev.lib.hasInfix targetManifestArgs old.postBuild
                && prev.lib.hasInfix "if ! $out/bin/nvim-wrapper" old.postBuild
              ) "Neovim's manifest wrapper command changed; update the cross overlay";
              prev.lib.replaceStrings
                [
                  targetManifestArgs
                  "if ! $out/bin/nvim-wrapper"
                ]
                [
                  (manifestWrapperArgs prev.pkgsBuildBuild.neovim-unwrapped)
                  "if ! ${prev.pkgsBuildBuild.bash}/bin/bash $out/bin/nvim-wrapper"
                ]
                old.postBuild;
            disallowedRequisites = (old.disallowedRequisites or [ ]) ++ [
              prev.pkgsBuildBuild.neovim-unwrapped
            ];
          }
        )
      );

  tree-sitter =
    if prev.stdenv.buildPlatform == prev.stdenv.hostPlatform then
      prev.tree-sitter
    else
      prev.tree-sitter.overrideAttrs (old: {
        # QuickJS is also a Cargo build dependency: its x86 bindings must use
        # build-host headers, while the generic bindgen hook supplies ARM headers.
        # Bindgen prefers this target-specific variable over its generic one.
        preBuild = ''
          export BINDGEN_EXTRA_CLANG_ARGS_x86_64_unknown_linux_gnu="$(< ${hostClang}/nix-support/cc-cflags) $(< ${hostClang}/nix-support/libc-cflags) $(< ${hostClang}/nix-support/libcxx-cxxflags)"
        ''
        + (old.preBuild or "");
      });
}
